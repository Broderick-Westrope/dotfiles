  "tokenColors": [
    {
      "name": "comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#565f89",
        "fontStyle": "italic"
      }
    },
    {
      "name": "comment.doc",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#5a6496",
        "fontStyle": "italic"
      }
    },
    {
      "name": "keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "string",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "string.escape",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "string.regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#b4f9f8"
      }
    },
    {
      "name": "string.special",
      "scope": [
        "string.other.symbol",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#73daca"
      }
    },
    {
      "name": "string.special.symbol",
      "scope": [
        "string.other.symbol",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#73daca"
      }
    },
    {
      "name": "number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "constant",
      "scope": [
        "constant",
        "variable.other.constant",
        "constant.language",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "function.method",
      "scope": [
        "entity.name.function.member",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "function.builtin",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "type",
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "type.builtin",
      "scope": [
        "support.type.primitive",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "enum",
      "scope": [
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "constructor",
      "scope": [
        "entity.name.function.constructor",
        "new.expr entity.name.type"
      ],
      "settings": {
        "foreground": "#2ac3de"
      }
    },
    {
      "name": "variable",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "variable.parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e0af68"
      }
    },
    {
      "name": "variable.member",
      "scope": [
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#73daca"
      }
    },
    {
      "name": "property",
      "scope": [
        "variable.other.property",
        "support.variable.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#73daca"
      }
    },
    {
      "name": "variable.special",
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.package",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "name": "tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f7768e"
      }
    },
    {
      "name": "label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "name": "punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "punctuation.bracket",
      "scope": [
        "punctuation.definition.block",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#a9b1d6"
      }
    },
    {
      "name": "punctuation.delimiter",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "punctuation.special",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "punctuation.list_marker",
      "scope": [
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "name": "preproc",
      "scope": [
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "name": "embedded",
      "scope": [
        "meta.embedded",
        "source.embedded"
      ],
      "settings": {
        "foreground": "#c0caf5"
      }
    },
    {
      "name": "emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "emphasis.strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": "bold"
      }
    },
    {
      "name": "title",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7aa2f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "link_text",
      "scope": [
        "markup.underline.link.text",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#73daca"
      }
    },
    {
      "name": "link_uri",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#7dcfff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "text.literal",
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "name": "variant",
      "scope": [
        "entity.name.type.enum.member"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#565f89",
      "italic": true
    },
    "keyword": {
      "foreground": "#bb9af7",
      "italic": true
    },
    "operator": "#89ddff",
    "string": "#9ece6a",
    "regexp": "#b4f9f8",
    "number": "#ff9e64",
    "variable.readonly": "#ff9e64",
    "enumMember": "#ff9e64",
    "function": "#7aa2f7",
    "method": "#7aa2f7",
    "function.defaultLibrary": "#2ac3de",
    "method.defaultLibrary": "#2ac3de",
    "type": "#2ac3de",
    "class": "#2ac3de",
    "interface": "#2ac3de",
    "struct": "#2ac3de",
    "typeParameter": "#2ac3de",
    "type.defaultLibrary": "#2ac3de",
    "enum": "#2ac3de",
    "variable": "#c0caf5",
    "parameter": "#e0af68",
    "property": "#73daca",
    "namespace": "#7dcfff",
    "decorator": "#bb9af7",
    "label": "#7aa2f7",
    "macro": "#7dcfff"
  }
}
