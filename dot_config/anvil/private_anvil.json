{
  "models": {
    "large": {
      "provider": "openai",
      "model": "gpt-5-astra"
    },
    "small": {
      "provider": "anthropic",
      "model": "claude-sonnet-5"
    }
  },
  "tools": {
    "agentic_fetch": {
      "model": "anthropic/claude-sonnet-5"
    }
  },
  "mcp": {
    "datadog": {
      "type": "http",
      "url": "https://mcp.datadoghq.com/v1/mcp?toolsets=all",
      "auth": "oauth",
      "lazy_description": "Datadog monitoring, observability, and APM. Provides tools for searching logs, traces/spans, metrics, RUM events, incidents, monitors, dashboards, notebooks, and services. Use for investigating production issues, querying infrastructure data, creating visualizations, and managing Datadog resources."
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp",
      "auth": "oauth",
      "clientName": "Claude Code",
      "lazy_description": "Figma design and collaboration. Provides tools for creating, editing, and collaborating on Figma designs. Use when prompted, for creating and editing designs."
    },
    "launchdarkly": {
      "type": "http",
      "url": "https://mcp.launchdarkly.com/mcp/fm",
      "auth": "oauth",
      "lazy_description": "LaunchDarkly feature flag management. Provides tools for creating, toggling, and configuring feature flags, managing targeting rules, rollouts, approval requests, and flag lifecycle (stale flag cleanup). Use for feature flag operations and management."
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "auth": "oauth",
      "lazy_description": "Linear project management. Provides tools for managing issues, projects, initiatives, milestones, cycles, documents, teams, users, labels, and status updates. Use for creating/updating tickets, planning work, tracking progress, and querying project data."
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp",
      "auth": "oauth",
      "clientId": "https://claude.ai/oauth/claude-code-client-metadata",
      "redirectUri": "http://localhost:8765/callback",
      "lazy_description": "Notion document and database management. Provides tools for creating, updating, and querying Notion databases, pages, blocks, and properties. Use for managing and querying Notion data."
    },
    "sigma": {
      "type": "http",
      "url": "https://api.au.aws.sigmacomputing.com/mcp/v2",
      "auth": "oauth",
      "lazy_description": "Sigma is a cloud-native analytics and business intelligence platform. Use when you want to analyse production data, in conjunction with the bq CLI."
    },
    "slack": {
      "type": "http",
      "url": "https://mcp.slack.com/mcp",
      "auth": "oauth",
      "clientId": "1601185624273.8899143856786",
      "redirectUri": "http://localhost:3118/callback",
      "lazy_description": "Slack messaging and collaboration. Provides tools for sending messages, creating channels, managing threads, and querying message history. Use for communication and collaboration across Slack teams."
    },
    "terminal": {
      "command": "node",
      "env": {
        "MCP_TERMINAL_DEFAULT_TIMEOUT": "2000",
        "MCP_TERMINAL_IDLE_TIMEOUT": "600000",
        "MCP_TERMINAL_MAX_SESSIONS": "4",
        "MCP_TERMINAL_SETTLE_MS": "600"
      },
      "args": [
        "$HOME/dev/helse/mcp-interactive-terminal/dist/bin.js"
      ],
      "type": "stdio",
      "lazy_description": "Interactive terminal sessions in a real PTY. Use for driving and manually testing TUI programs: spawn a process, send keys and control characters, resize the terminal, and read back the rendered screen. Also useful for REPLs, SSH, and database clients that need a persistent interactive session rather than one-shot bash commands."
    },
    "muninn": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/muninn",
      "args": [
        "mcp"
      ]
    }
  },
