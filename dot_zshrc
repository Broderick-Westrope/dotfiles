# review a PR on a worktree
revwt() {
  local branch=$(gh pr view "$1" --json headRefName -q .headRefName)
  git fetch origin "$branch"
  if ! wtp add "$branch" --exec "$EDITOR ." 2>/dev/null; then
    wtp exec "$branch" -- $EDITOR .
  fi
}
