# Function to re-run the last X commands defined in a variable
function rerun_last() {
  local num_commands=${1:-2} # Default to 2 if no argument is provided
  local history_offset=$((num_commands + 1))
  local range_start=$(history -n -$history_offset | head -n 1 | awk '{print $1}')
  local range_end=$(history -n -2 | head -n 1 | awk '{print $1}')

  if [[ -z "$range_start" || -z "$range_end" ]]; then
    echo "Could not find sufficient history."
    return 1
  fi

  echo "Running commands $range_start to $range_end:"
  # Execute the commands directly using 'fc -s'
  fc -s "$range_start" "$range_end"
}


